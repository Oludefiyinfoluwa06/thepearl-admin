# Copy to .env.local. Never commit real values.

# Creates the first owner account when the database is empty (first run only).
ADMIN_SEED_NAME=Owner
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=change-me-please

# Outgoing email (invitations, password resets). Same SMTP account style as the website.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional display sender, e.g. "The Pearl Admin" <no-reply@yourdomain.com>
# MAIL_FROM=
# Public URL of this dashboard, used in emailed links. Falls back to the request's host.
# APP_URL=https://admin.example.com

# Shared secret the website sends (x-intake-key header) to POST /api/intake/website. 16+ chars.
INTAKE_API_KEY=

# MongoDB Atlas connection string and database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_DB=tptt-admin

# Optional: if mongodb+srv lookups fail on your network (querySrv ECONNREFUSED), force public DNS.
# DNS_SERVERS=8.8.8.8,1.1.1.1
